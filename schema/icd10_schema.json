{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthArticleConditions",
  "type": "object",
  "properties": {
    "conditions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The clinical name of the condition or disease"
          },
          "icd10cm_code": {
            "type": "string",
            "description": "Valid ICD-10-CM diagnosis code (e.g., E11.9, I10, J45.909)"
          },
          "tier": {
            "type": "string",
            "enum": ["primary", "secondary", "tertiary"],
            "description": "primary: the article is mostly about it; secondary: a real part of it; tertiary: a short mention"
          }
        },
        "required": ["name", "icd10cm_code", "tier"],
        "additionalProperties": false
      }
    }
  },
  "required": ["conditions"],
  "additionalProperties": false
}
